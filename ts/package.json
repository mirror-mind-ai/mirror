{
  "name": "mirror-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mirror Mind TypeScript core (database-seam strangler of the Python core)",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#backup/*": "./src/backup/*",
    "#consult/*": "./src/consult/*",
    "#conversation/*": "./src/conversation/*",
    "#cultivation/*": "./src/cultivation/*",
    "#db/*": "./src/db/*",
    "#descriptor/*": "./src/descriptor/*",
    "#explorer/*": "./src/explorer/*",
    "#extraction/*": "./src/extraction/*",
    "#extensions/*": "./src/extensions/*",
    "#frontDoor/*": "./src/frontDoor/*",
    "#identity/*": "./src/identity/*",
    "#init/*": "./src/init/*",
    "#journey/*": "./src/journey/*",
    "#memory/*": "./src/memory/*",
    "#mirror/*": "./src/mirror/*",
    "#mode/*": "./src/mode/*",
    "#observability/*": "./src/observability/*",
    "#parity/*": "./src/parity/*",
    "#persona/*": "./src/persona/*",
    "#providers/*": "./src/providers/*",
    "#repair/*": "./src/repair/*",
    "#runtime/*": "./src/runtime/*",
    "#search/*": "./src/search/*",
    "#seed/*": "./src/seed/*",
    "#planning/*": "./src/planning/*",
    "#soul/*": "./src/soul/*",
    "#tasks/*": "./src/tasks/*",
    "#util/*": "./src/util/*",
    "#welcome/*": "./src/welcome/*",
    "#fixtures/*": "./test/fixtures/*",
    "#goldens/*": "./test/goldens/*",
    "#helpers/*": "./test/helpers/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
