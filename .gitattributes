# Normalize line endings. Windows installer scripts must keep CRLF so they run
# correctly when checked out on Windows; POSIX shell scripts must stay LF.
* text=auto eol=lf

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.iss   text eol=crlf

*.sh    text eol=lf

# Parity fixture trees are graded BYTE for byte against a Python oracle, and the
# goldens are generated from these exact bytes. One of them deliberately carries
# CRLF endings to prove the roadmap parser handles them, so `text=auto eol=lf`
# would rewrite the fixture on checkout and make the committed golden wrong on a
# clean clone — green locally, red in CI, for a reason nobody would look for.
# `-text` disables all end-of-line conversion here.
ts/test/fixtures/**  -text

# Binary assets — never touch.
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
