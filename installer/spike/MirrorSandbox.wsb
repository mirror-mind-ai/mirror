<Configuration>
  <!-- Mirror Mind installer spike: a clean Windows, the script read-only, the
       results written back to the host. Double-click to start.
       Host paths are the dedicated worktree of the windows/installer branch
       (C:\VSCode\mirror-installer), so the files stay put while the PR
       workshop (mirror-windows-ts) switches branches. -->
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\VSCode\mirror-installer\installer\spike</HostFolder>
      <SandboxFolder>C:\Spike</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\VSCode\mirror-installer\.local\sandbox-out</HostFolder>
      <SandboxFolder>C:\Out</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "Mirror Mind spike" powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\Spike\install.ps1 -User Rodrigo -OutDir C:\Out -Launch</Command>
  </LogonCommand>
</Configuration>
