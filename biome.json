{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "files": {
    "includes": [
      "bin/*.js",
      "ts/src/**/*.ts",
      "ts/test/**/*.ts",
      "ts/evals/**/*.ts",
      "ts/scripts/**/*.ts",
      "ts/smoke/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["ts/src/db/schemaInventorySnapshot.ts"],
      "javascript": {
        "formatter": {
          "quoteProperties": "preserve",
          "trailingCommas": "none"
        }
      }
    }
  ]
}
