.DS_Store
__pycache__/
# Fallback eval-run history when no mirror home is configured (CV9.E2.S19).
# The comment must sit on its own line — git treats trailing text after a
# pattern as part of the pattern, so an inline comment silently disabled this.
evals/.history/
*.pyc
.env
claude.sh
.claude/settings.local.json
.claude/worktrees/
.claude/skills/ext:*/
.claude/skills/extensions.external.json
conversas/
.venv/
*.egg-info/
.coverage
.pytest_cache/
.ruff_cache/
node_modules/

pi_exports/
docs/project/explorations/
.mirror-clone-role
.mirror-update-channel
# Generated Journey read models, locks, and immutable local receipts.
.mirror/projections/

# Local recovery/backup notes and patches (Windows compat workflow)
tmp/

# Windows installer build artifacts
dist/
*.exe

# Stray Pi session exports. `pi --export` writes to the working directory when
# given a bare filename, so an export run from the repo root lands here instead
# of the journey's export folder. These are multi-MB conversation transcripts
# that belong in the session archive, never in git history.
pi-session-*.html
pi-session-*.html.gz
