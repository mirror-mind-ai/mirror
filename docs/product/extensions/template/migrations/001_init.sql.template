-- Initial schema for the <id> extension.
-- Replace <id> with the extension's id, and <id_underscored> with the same id,
-- dashes as underscores (my-widget -> my_widget): it names the tables.
--
-- Rules (enforced by the migration runner):
--   * Every CREATE/ALTER/DROP must target tables matching ext_<id_underscored>_*.
--   * Index names follow ext_<id_underscored>_* by convention.
--   * The whole file runs in a single transaction.
--   * Never edit this file after it has been applied. Add a new migration
--     file instead (002_*.sql, 003_*.sql, ...).

CREATE TABLE ext_<id_underscored>_examples (
  id          INTEGER PRIMARY KEY AUTOINCREMENT,
  name        TEXT NOT NULL,
  created_at  TEXT NOT NULL
);

CREATE INDEX idx_ext_<id_underscored>_examples_created
  ON ext_<id_underscored>_examples(created_at);
