# Replace <id> with the extension id (lowercase, dash-separated).
# Replace <Human Name> with a short display name.
# Replace <one-line summary> with a single-sentence description.

id: <id>
name: <Human Name>
category: extension
kind: command-skill
summary: <one-line summary>
table_prefix: ext_<id>_

entrypoint:
  module: extension          # filename without .py
  # function: register       # default; omit unless renamed

runtimes:
  pi:
    command_name: ext-<id>
    skill_file: SKILL.md
  claude:
    command_name: ext:<id>
    skill_file: SKILL.md
  # Add gemini / codex entries if the extension supports them.

# Declare capabilities that the extension exposes for Mirror Mode injection.
# Remove the section entirely if the extension does not provide context.
mirror_context_providers:
  - id: <capability_id>
    description: <one-line description of what this capability returns>
    suggested_personas: []   # informational only; never auto-binds
    provider_runtime:
      protocol: mirror-context-v1
      command: [node, context-provider.mjs]

# Optional: declared CLI subcommands. `name` and `summary` are informational
# while extension.py registers the handler via api.register_cli. Adding
# `runtime` makes the core execute the command directly, in any language, and
# is what frees the subcommand from the Python compatibility host before
# CV22.DS10 removes it. Migrate one subcommand at a time: the fallback is per
# subcommand, not per extension.
cli:
  subcommands:
    - name: <subcommand>
      summary: <one-line>
      runtime:
        protocol: mirror-cli-v1
        command: [node, commands/<subcommand>.mjs]

# Optional: declare a minimum core API version.
requires:
  extension_api: ">=1.0,<2.0"
