"""Reference `mirror-cli-v1` shim for an extension with Python handlers.

WHO THIS IS FOR
    An extension that was written against the in-process Extension API --
    `register(api)` plus `api.register_cli(...)` -- and needs to keep working
    after CV22.DS10.TS2 deleted the Mirror core's Python compatibility host.

    Copy this file into your extension as `cli.py`, then declare a runtime for
    each subcommand in `skill.yaml`:

        cli:
          subcommands:
            - name: campaigns
              summary: ...
              runtime:
                protocol: mirror-cli-v1
                command: [python3, cli.py, campaigns]

    Migration is per capability. An extension may declare a runtime for one
    subcommand and leave the others for later; the migrated ones work
    immediately and the rest refuse with a message naming this fix.

WHAT IT IS NOT
    Not part of the Mirror core, and not a Mirror-maintained runtime. It runs
    as YOUR extension, in an interpreter you choose. The core spawns the
    command your manifest declares and nothing else.

    Personal tooling, as shipped. The `python3` in the declaration above
    resolves from the ambient `PATH`, which is correct for extensions you run
    on machines you control and undecided for extensions you distribute --
    see CR092. If you publish an extension, pin the interpreter yourself.

THE TWO PROPERTIES THIS FILE EXISTS TO PRESERVE
    The core used to own both. If your shim drops them, your extension
    silently gains privileges and loses safety it had before migrating.

    1. WRITE PREFIX GUARD. `api.execute` refused any write outside your own
       `ext_<id>_*` tables. Without the guard, a bug in a handler can now
       corrupt identity, memories, or conversations instead of being
       rejected. Ported faithfully from `memory/extensions/api.py` and
       `memory/extensions/migrations.py`.

    2. CONNECTION DISCIPLINE. The core opens `memory.db` with
       `busy_timeout=30000` and `foreign_keys=ON`. A bare `sqlite3.connect`
       gives a 5-second timeout and NO foreign-key enforcement, which shows up
       as intermittent `database is locked` under normal concurrent use, and
       as orphan rows that SQLite quietly accepted.

    There is deliberately NO raw-connection escape hatch here. The old
    `api.db` property existed for performance-sensitive core paths; exposing
    it in a shim would reintroduce exactly the hole the guard closes.

CONTEXT PROVIDERS
    This shim covers `mirror-cli-v1` (subcommands). A `mirror-context-v1`
    provider is a different, simpler contract: read one JSON request on
    stdin, write one JSON response on stdout. See
    docs/product/extensions/api-reference.md.
"""

from __future__ import annotations

import os
import re
import sqlite3
import sys
from contextlib import contextmanager

# --- The prefix guard, ported from the core -------------------------------

_WRITE_KEYWORDS = (
    "INSERT",
    "UPDATE",
    "DELETE",
    "CREATE",
    "ALTER",
    "DROP",
    "REPLACE",
    "TRUNCATE",
)

_LEADING_KEYWORD_RE = re.compile(r"^\s*([A-Za-z]+)")

_DDL_TABLE_RE = re.compile(
    r"""
    \b(?:
        CREATE\s+(?:VIRTUAL\s+)?TABLE        |
        ALTER\s+TABLE                        |
        DROP\s+TABLE                         |
        INSERT\s+(?:OR\s+\w+\s+)?INTO        |
        UPDATE                               |
        DELETE\s+FROM
    )
    \s+(?:IF\s+(?:NOT\s+)?EXISTS\s+)?
    "?([A-Za-z_][A-Za-z0-9_]*)"?
    """,
    re.IGNORECASE | re.VERBOSE,
)

_INDEX_TABLE_RE = re.compile(
    r"""
    \bCREATE\s+(?:UNIQUE\s+)?INDEX\s+
    (?:IF\s+NOT\s+EXISTS\s+)?
    (?:"?[A-Za-z_][A-Za-z0-9_]*"?\s+)?
    ON\s+
    "?([A-Za-z_][A-Za-z0-9_]*)"?
    """,
    re.IGNORECASE | re.VERBOSE,
)

_STRIP_COMMENTS_RE = re.compile(r"--[^\n]*|/\*.*?\*/", re.DOTALL)
_STRIP_STRINGS_RE = re.compile(r"'(?:[^']|'')*'")


class ExtensionPermissionError(RuntimeError):
    """Raised when a handler tries to write outside its own tables."""


def _is_write(sql: str) -> bool:
    match = _LEADING_KEYWORD_RE.match(sql)
    return (match.group(1).upper() if match else "") in _WRITE_KEYWORDS


def _extract_table_targets(sql: str) -> list[str]:
    """Every table this statement reads or writes.

    Conservative by design: comments and string literals are stripped first so
    a table name mentioned inside a literal cannot smuggle a write past the
    guard.
    """
    cleaned = _STRIP_STRINGS_RE.sub("''", _STRIP_COMMENTS_RE.sub("", sql))
    tables = [m.group(1).lower() for m in _DDL_TABLE_RE.finditer(cleaned)]
    tables.extend(m.group(1).lower() for m in _INDEX_TABLE_RE.finditer(cleaned))
    return tables


# --- The API surface a legacy handler expects ------------------------------


class ShimAPI:
    """What `api` means inside a migrated handler.

    Deliberately small: the four members real extensions use (`register_cli`,
    `read`, `execute`, `commit`) plus `executemany` and `transaction`. If your
    handler needs something the core API had and this does not, port that
    method here rather than reaching for the raw connection.
    """

    def __init__(self, extension_id: str, database_path: str) -> None:
        self.extension_id = extension_id
        self.table_prefix = "ext_" + extension_id.replace("-", "_") + "_"
        self.cli_registry: dict[str, object] = {}
        self._summaries: dict[str, str] = {}
        self._db = sqlite3.connect(database_path)
        self._db.row_factory = sqlite3.Row
        # The core's connection contract. Neither line is optional: see the
        # module docstring.
        self._db.execute("PRAGMA busy_timeout=30000")
        self._db.execute("PRAGMA foreign_keys=ON")

    # -- registration --
    def register_cli(self, subcommand: str, handler, *, summary: str | None = None) -> None:
        if not isinstance(subcommand, str) or not subcommand:
            raise ValueError("subcommand must be a non-empty string")
        if not callable(handler):
            raise ValueError("handler must be callable")
        self.cli_registry[subcommand] = handler
        self._summaries[subcommand] = summary or ""

    def register_mirror_context(self, capability_id: str, provider) -> None:
        """Accepted and ignored: context providers declare their own runtime.

        Present so an extension whose `register` registers BOTH a context
        provider and CLI subcommands can be imported by this shim without
        raising. The provider is never invoked from here.
        """
        return None

    # -- database --
    def read(self, sql: str, params=()) -> sqlite3.Cursor:
        """Read-only query. May touch any table; refuses writes."""
        if _is_write(sql):
            raise ExtensionPermissionError(
                "read() refuses write statements; use execute() instead"
            )
        return self._db.execute(sql, params)

    def execute(self, sql: str, params=()) -> sqlite3.Cursor:
        """Run a statement. Writes must target `ext_<id>_*` tables."""
        if _is_write(sql):
            self._enforce_prefix(sql)
        return self._db.execute(sql, params)

    def executemany(self, sql: str, seq_of_params) -> sqlite3.Cursor:
        if _is_write(sql):
            self._enforce_prefix(sql)
        return self._db.executemany(sql, seq_of_params)

    def commit(self) -> None:
        self._db.commit()

    @contextmanager
    def transaction(self):
        savepoint = "ext_shim_" + self.extension_id.replace("-", "_")
        self._db.execute(f"SAVEPOINT {savepoint}")
        try:
            yield
        except Exception:
            self._db.execute(f"ROLLBACK TO SAVEPOINT {savepoint}")
            self._db.execute(f"RELEASE SAVEPOINT {savepoint}")
            raise
        else:
            self._db.execute(f"RELEASE SAVEPOINT {savepoint}")
            self._db.commit()

    def close(self) -> None:
        self._db.close()

    def _enforce_prefix(self, sql: str) -> None:
        for table in _extract_table_targets(sql):
            if not table.startswith(self.table_prefix):
                raise ExtensionPermissionError(
                    f"write to '{table}' rejected: outside the required "
                    f"prefix '{self.table_prefix}*'"
                )


# --- Entry point -----------------------------------------------------------


def main(argv: list[str]) -> int:
    """Run one subcommand: `python3 cli.py <subcommand> [args...]`.

    The subcommand name is baked into the declared command in `skill.yaml`,
    so it arrives as `argv[0]` here and the user's own arguments follow it.

    Context arrives in the ENVIRONMENT, never on stdin -- stdin belongs to the
    user, and a migrated command can read it, which the retired bridge could
    never allow.
    """
    if not argv:
        sys.stderr.write("cli.py: no subcommand given\n")
        return 2
    subcommand, args = argv[0], argv[1:]

    extension_id = os.environ.get("MIRROR_EXTENSION_ID", "")
    database_path = os.environ.get("MIRROR_DATABASE_PATH", "")
    if not extension_id or not database_path:
        sys.stderr.write(
            "cli.py: MIRROR_EXTENSION_ID and MIRROR_DATABASE_PATH must be set. "
            "This command is meant to be launched by Mirror.\n"
        )
        return 2

    # The extension root is the cwd Mirror spawns us in, and also arrives as
    # MIRROR_EXTENSION_ROOT. Import the extension module beside this file.
    sys.path.insert(0, os.environ.get("MIRROR_EXTENSION_ROOT", os.getcwd()))
    import extension  # noqa: E402  (deliberately late: needs sys.path first)

    api = ShimAPI(extension_id, database_path)
    try:
        extension.register(api)
        handler = api.cli_registry.get(subcommand)
        if handler is None:
            sys.stderr.write(
                f"cli.py: extension/{extension_id} registered no handler for "
                f"'{subcommand}'\n"
            )
            return 1
        result = handler(api, args)
        # Legacy handlers were loose about this: a `None` return meant 0, and a
        # stringy return was coerced. Preserved so a migrated handler behaves
        # exactly as it did before.
        if result is None:
            return 0
        return int(result)
    except ExtensionPermissionError as error:
        sys.stderr.write(f"cli.py: {error}\n")
        return 1
    finally:
        api.close()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
