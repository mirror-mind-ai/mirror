# Mirror Mind — Canonical environment reference.
#
# This file lists every environment variable the memory system reads, with
# its default and its role. For a minimal starter template, see
# `.env.example`. For the operational doc, see the "Configuration" section
# of REFERENCE.md.
#
# `.env` is loaded by Node, not by Mirror: every invocation passes it with
# `node --env-file=.env` (the skills) or `--env-file-if-exists` (the hook
# wrappers and the MCP launcher). Values already set in the real environment
# take precedence over the file.


# ==========================================================================
# Identity — CV4 user home
# ==========================================================================

# In production, one of MIRROR_HOME or MIRROR_USER must be set. Both may be
# set only if they agree (MIRROR_HOME must end in the same user name).
# Tests and development can run without either.

# Explicit path to the user's mirror home. Takes precedence over MIRROR_USER.
# MIRROR_HOME=~/.mirror-minds/your-name

# Short user name. Resolves to ~/.mirror-minds/<user>.
# MIRROR_USER=your-name


# ==========================================================================
# API keys
# ==========================================================================

# OpenRouter — used for embeddings (openai/text-embedding-3-small via OpenRouter),
# memory extraction (Gemini Flash), and the multi-LLM consult command.
# No separate OPENAI_API_KEY is needed.
OPENROUTER_API_KEY=


# ==========================================================================
# Environment selection
# ==========================================================================

# One of: production, development, test. Default: production.
# Selects the database file NAME (memory.db, memory_dev.db, memory_test.db),
# never its directory.
# MEMORY_ENV=production


# ==========================================================================
# Path overrides — rarely set
# ==========================================================================
#
# Under CV4 these are all derived from the resolved MIRROR_HOME in production.
# Set them only when you need to override the default layout (e.g. keeping
# the DB on external storage, sharing backups across users, running tests
# against a custom directory).

# Runtime working directory. Holds the `mute` flag file and the
# `.bootstrap.lock` file. Defaults to the resolved mirror home in every
# environment.
# MEMORY_DIR=

# Production-only runtime directory override. Rarely useful unless you run
# a separate production instance alongside development. Defaults to
# MEMORY_DIR.
# MEMORY_PROD_DIR=

# Full path to the SQLite database. Defaults to <MIRROR_HOME>/memory.db in
# production; <MEMORY_DIR>/memory_<env>.db otherwise.
# DB_PATH=

# DEPRECATED: BACKUP_DIR no longer redirects backups. `mirror backup` writes to
# <MIRROR_HOME>/backups; if this is set, the command prints a warning and
# ignores it. Use `mirror backup --backup-dir <path>` for an intentional,
# per-invocation destination.
# BACKUP_DIR=

# INERT since CV22.DS10.TS5: DB_BACKUP_PATH, EXPORT_DIR, and
# TRANSCRIPT_EXPORT_DIR were read only by the Python core, which is deleted.
# Nothing reads them now. See docs/reference/configuration.md#inert-values.


# ==========================================================================
# Runtime integrations
# ==========================================================================

# Source directory for `backfill_pi_sessions` (CV3 Pi runtime). Override
# when Pi session files live outside the default location, or when running
# a second mirror home on the same machine that should not pick up the
# primary user's Pi sessions. Default: ~/.pi/agent/sessions.
# PI_SESSIONS_DIR=

# Reception — LLM-based intent and persona classification. Enabled by default.
# Set to 0 to disable the LLM call and fall back to keyword detection.
# MEMORY_RECEPTION=0

# Fallback session id used by conversation-logger CLIs when neither
# `--session-id` nor a hook payload is available. Builder lifecycle
# commands also treat it as a named session and bind its Builder journey
# when `--journey` is absent. Never set it here: this file is shared by
# every window, so all of them would name the same session, and a Builder
# command would follow whichever window loaded last. Almost never set by
# humans; reserved for scripted integrations that inject it per process.
# MIRROR_SESSION_ID=

# The `node` binary the runtime hook wrappers run. Set it when a runtime
# launched from the GUI does not inherit the PATH that holds node. Without it
# a wrapper tries `command -v node`, then ~/.nvm/current/bin/node,
# /opt/homebrew/bin/node, and /usr/local/bin/node; a wrapper that finds none
# skips the hook and writes one line to <MIRROR_HOME>/hooks.log.
# MIRROR_NODE=

# INERT since CV22.DS10.TS5: every MIRROR_TS_<FAMILY>=0 revert variable
# (MIRROR_TS_BUILD, MIRROR_TS_MCP, MIRROR_TS_SEARCH, ...). The Python engine
# they sent a command back to is deleted; `mirror runtime diagnose` names any
# still set. The MIRROR_TS_*_REPLAY fixture paths are NOT inert.


# ==========================================================================
# Variables set by external runtimes (do NOT set manually)
# ==========================================================================
#
# - CLAUDE_PROJECT_DIR is set by Claude Code when it invokes hooks.
# - Claude Code hook payloads carry `session_id` on stdin.
# - Pi's extension passes the session file path to the logger CLI.
